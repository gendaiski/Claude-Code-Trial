    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Summarise these metrics vs target and vs yesterday. Call out what moved and why it might matter. Return {\\\"headline\\\":\\\"...\\\",\\\"highlights\\\":[\\\"...\\\"],\\\"watch\\\":[\\\"...\\\"]}. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "1d257d99-4547-4eac-804b-c3ed11aad638",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
