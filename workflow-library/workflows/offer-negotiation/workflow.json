    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Capture this offer (price, conditions, financing, timeline, inclusions), compare to the asking/valuation, and draft counter-offer options with rationale and fallbacks. Return {\\\"summary\\\":\\\"...\\\",\\\"gap\\\":\\\"...\\\",\\\"counters\\\":[{\\\"terms\\\":\\\"...\\\",\\\"rationale\\\":\\\"...\\\"}],\\\"heads_of_terms\\\":\\\"...\\\"}. Only progress after the compliance gate. A licensed broker/agent (and the client's lawyer) reviews before anything is listed, offered, signed, or transferred; money moves only through proper escrow/solicitor accounts with human authorisation; confirm the jurisdiction's rules.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "6142b9a6-84c4-4980-972b-94cd7437f793",
