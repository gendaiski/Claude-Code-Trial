    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"From these live deals (with stages, documents, and dates), flag milestones, missing documents, and deadlines due in the next 3/7/14 days for each jurisdiction's process (UK exchange/completion/HMLR/SDLT; Egypt Shahr Aqari registration; Dubai NOC/DLD transfer). Return {\\\"actions\\\":[{\\\"deal\\\":\\\"...\\\",\\\"event\\\":\\\"...\\\",\\\"due\\\":\\\"...\\\",\\\"owner\\\":\\\"...\\\",\\\"blocker\\\":\\\"...\\\"}]}. A licensed broker/agent (and the client's lawyer) reviews before anything is listed, offered, signed, or transferred; money moves only through proper escrow/solicitor accounts with human authorisation; confirm the jurisdiction's rules.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "5561866c-7930-4fb5-a3ab-7f8f363f935d",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
