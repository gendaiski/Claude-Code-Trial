      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"You are the legal front door. Classify the request into a team: contracts|nda|compliance|data-protection|litigation|ip|other. Extract the ask, urgency, and any deadline. Return {\\\"team\\\":\\\"...\\\",\\\"ask\\\":\\\"...\\\",\\\"urgency\\\":\\\"low|med|high\\\",\\\"deadline\\\":\\\"...\\\"}. Drafting support, not legal advice \\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
