      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"For this proposed action, feature, or campaign, list the applicable regimes and the trigger for each, the required control/approval and owner, and the residual risk. Decide proceed | proceed-with-conditions | escalate. Return {\\\"regimes\\\":[{\\\"regime\\\":\\\"...\\\",\\\"trigger\\\":\\\"...\\\",\\\"control\\\":\\\"...\\\",\\\"owner\\\":\\\"...\\\",\\\"risk\\\":\\\"Low|Med|High\\\"}],\\\"decision\\\":\\\"...\\\"}. Drafting support, not legal advice \\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "f0f98e96-ddd2-4972-96fa-5b8c71d1f267",
