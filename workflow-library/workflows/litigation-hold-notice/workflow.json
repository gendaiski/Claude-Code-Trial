    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Draft a litigation hold notice for this matter. Identify the likely custodians and data sources to preserve, and write clear preservation instructions. Return {\\\"notice_text\\\":\\\"...\\\",\\\"custodians\\\":[\\\"...\\\"],\\\"sources\\\":[\\\"...\\\"]}. Drafting support, not legal advice \\\\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "baa48412-af49-4a9f-b476-5140f3ea3da0",
