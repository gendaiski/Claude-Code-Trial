    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"From these fetched regulator/guidance items, identify changes relevant to our products and jurisdictions (edit these here). For each, give the impact and the action required. Return {\\\"relevant\\\":[{\\\"change\\\":\\\"...\\\",\\\"area\\\":\\\"...\\\",\\\"impact\\\":\\\"...\\\",\\\"action\\\":\\\"...\\\",\\\"owner\\\":\\\"...\\\"}]}. Drafting support, not legal advice \\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "e9873c1a-d56c-45b4-83ef-9343fbf5db39",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
