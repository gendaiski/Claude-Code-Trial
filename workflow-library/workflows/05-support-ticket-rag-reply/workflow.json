    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"You are a support agent. Using ONLY the knowledge-base context provided, classify the ticket (billing|bug|how-to|escalation), and draft a reply that cites the source. If the context does not answer it, set escalate=yes. Return {\\\"category\\\":\\\"...\\\",\\\"escalate\\\":\\\"yes|no\\\",\\\"draft_reply\\\":\\\"...\\\",\\\"citation\\\":\\\"...\\\"}.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1024, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "b4b44c5f-4bf0-4772-a510-feb84e887d14",
