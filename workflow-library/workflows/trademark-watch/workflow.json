    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"From these watch results, flag potentially infringing or confusingly similar marks against our marks and names (edit the list here \\u2014 include any geographical indications such as \\u2018Egyptian Cotton\\u2019). Rate the risk for each. Return {\\\"hits\\\":[{\\\"mark\\\":\\\"...\\\",\\\"similar_to\\\":\\\"...\\\",\\\"risk\\\":\\\"Low|Med|High\\\",\\\"note\\\":\\\"...\\\"}]}. Drafting support, not legal advice \\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "554db974-4c6b-4472-b722-3ac74266b1e6",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
