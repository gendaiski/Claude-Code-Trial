    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Classify this IP matter (patent|trademark|design|copyright|geographical-indication). Summarise it, flag any priority dates or filing deadlines, and route. Return {\\\"ip_type\\\":\\\"...\\\",\\\"summary\\\":\\\"...\\\",\\\"deadlines\\\":[\\\"...\\\"],\\\"routing\\\":\\\"...\\\"}. Drafting support, not legal advice \\\\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "27ec4038-d480-4b68-bb0a-059e3fd92846",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.claudeBody }}",
        "options": {}
      },
      "id": "e7320e0e-dc68-412f-a68e-d8c8aa3c05d8",
      "name": "Assess: ask Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        490,
