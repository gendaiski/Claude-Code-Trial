    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Classify this ticket: {\\\"category\\\":\\\"billing|technical|account|other\\\",\\\"priority\\\":\\\"P1|P2|P3\\\",\\\"sentiment\\\":\\\"...\\\",\\\"route\\\":\\\"auto-reply|agent|escalate\\\",\\\"summary\\\":\\\"...\\\"}. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "88053cfb-3765-4b1d-aea7-a20060f039f4",
