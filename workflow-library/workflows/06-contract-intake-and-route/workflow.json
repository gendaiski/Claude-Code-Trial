    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"You are a legal-ops assistant. Detect the contract type (NDA|MSA|SOW|order-form) and parties, flag the top risks (liability, IP, termination, data), and give a routing colour. Return {\\\"type\\\":\\\"...\\\",\\\"parties\\\":\\\"...\\\",\\\"routing\\\":\\\"GREEN|YELLOW|RED\\\",\\\"top_risks\\\":[\\\"...\\\"]}. This is drafting support, not legal advice.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1024, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "45c46a8e-f28d-4f38-ab34-4f0ec2f34ffa",
