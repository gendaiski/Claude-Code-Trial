    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"From this issue and the relevant code context, produce {\\\"root_cause\\\":\\\"...\\\",\\\"plan\\\":[\\\"...\\\"],\\\"patch_summary\\\":\\\"...\\\",\\\"tests_to_add\\\":[\\\"...\\\"],\\\"risk\\\":\\\"Low|Med|High\\\"}. Do not claim to have tested it. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "27d49f0c-f258-4c3b-ba8b-5884ce5f4185",
