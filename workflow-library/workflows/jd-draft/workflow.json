    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"From this role brief, draft an inclusive JD: {\\\"title\\\":\\\"...\\\",\\\"summary\\\":\\\"...\\\",\\\"responsibilities\\\":[\\\"...\\\"],\\\"requirements\\\":[\\\"...\\\"],\\\"nice_to_have\\\":[\\\"...\\\"]}. Neutral, inclusive language; no unnecessary requirements. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "78066d46-7f93-4e90-83b9-7f561f22c8b5",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
