    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Answer the research question using ONLY the provided sources. Return {\\\"question\\\":\\\"...\\\",\\\"answer\\\":\\\"...\\\",\\\"key_points\\\":[\\\"...\\\"],\\\"sources_used\\\":[\\\"...\\\"],\\\"open_questions\\\":[\\\"...\\\"]}. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "faba1041-a96a-44d2-b9fd-92f13d27effc",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
