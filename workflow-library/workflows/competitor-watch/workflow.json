    },
    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"From these fetched competitor updates, summarise what changed, the implication for us, and any positioning move. Return {\\\"items\\\":[{\\\"competitor\\\":\\\"...\\\",\\\"change\\\":\\\"...\\\",\\\"implication\\\":\\\"...\\\",\\\"action\\\":\\\"...\\\"}]}. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "878f5057-c218-4fd6-9898-84ef228a7d0e",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.claudeBody }}",
        "options": {}
      },
      "id": "95155bee-be5f-4552-921d-0b49c7ea0178",
      "name": "Assess: ask Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Anthropic API (Header Auth: x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const txt=($json.content&&$json.content[0]&&$json.content[0].text)||\"\";\nlet data={};\ntry{const m=txt.match(/\\{[\\s\\S]*\\}/);data=m?JSON.parse(m[0]):{};}catch(e){data={};}\nreturn { json: { ...data, _raw: txt, _input: $json._input } };"
      },
      "id": "72baa20f-245b-4f86-8ed3-faa28f2ad6e7",
      "name": "Assess: parse",
