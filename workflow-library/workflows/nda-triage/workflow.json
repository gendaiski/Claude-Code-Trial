    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Triage this NDA. Classify GREEN (signable under delegation), YELLOW (counsel review), or RED (full review). Check mutuality, term, definition of confidential info, permitted use, carve-outs; flag any embedded non-solicit/non-compete/IP-assignment. Return {\\\"routing\\\":\\\"GREEN|YELLOW|RED\\\",\\\"issues\\\":[\\\"...\\\"],\\\"counter\\\":\\\"suggested wording for the two clauses to fix first\\\"}. Drafting support, not legal advice \\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "cab5305d-0f6b-4ddd-aab2-30eccce370f4",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.claudeBody }}",
        "options": {}
      },
      "id": "105c3c5c-1a68-4687-aa37-fc7d12b619be",
      "name": "Assess: ask Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        490,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Anthropic API (Header Auth: x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const txt=($json.content&&$json.content[0]&&$json.content[0].text)||\"\";\nlet data={};\ntry{const m=txt.match(/\\{[\\s\\S]*\\}/);data=m?JSON.parse(m[0]):{};}catch(e){data={};}\nreturn { json: { ...data, _raw: txt, _input: $json._input } };"
      },
      "id": "14106ea7-5fff-4887-adc9-2eefeed1e3f9",
