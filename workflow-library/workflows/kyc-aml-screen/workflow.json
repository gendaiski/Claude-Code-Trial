      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "1f1215c1-b866-4672-9651-f1c68daa59a8",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "stop",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "d7729e5b-8852-489e-baaf-bac138c6ea0d",
