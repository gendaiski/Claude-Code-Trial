    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Run the compliance gate for this deal: KYC (identity + beneficial ownership), AML risk (source of funds, cash, PEP), sanctions screening, and regime fit (licensing, disclosures, escrow) for the jurisdiction. Return {\\\"kyc\\\":\\\"pass|fail\\\",\\\"aml_risk\\\":\\\"Low|Med|High\\\",\\\"sanctions\\\":\\\"clear|hit\\\",\\\"regime_ok\\\":\\\"yes|no\\\",\\\"decision\\\":\\\"proceed|conditions|stop\\\",\\\"reasons\\\":[\\\"...\\\"]}. Never clear or file autonomously. A licensed broker/agent (and the client's lawyer) reviews before anything is listed, offered, signed, or transferred; money moves only through proper escrow/solicitor accounts with human authorisation; confirm the jurisdiction's rules.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "fd707f73-c232-4a11-8561-2bded09988bf",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.claudeBody }}",
        "options": {}
      },
      "id": "44a7e010-c6b7-43cc-bed9-082f6f6c56e2",
      "name": "Assess: ask Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        490,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Anthropic API (Header Auth: x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const txt=($json.content&&$json.content[0]&&$json.content[0].text)||\"\";\nlet data={};\ntry{const m=txt.match(/\\{[\\s\\S]*\\}/);data=m?JSON.parse(m[0]):{};}catch(e){data={};}\nreturn { json: { ...data, _raw: txt, _input: $json._input } };"
      },
      "id": "77cc5dd9-a9b2-46d9-a8dc-a1d00d801c56",
      "name": "Assess: parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
