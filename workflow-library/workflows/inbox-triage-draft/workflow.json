          },
          "combinator": "and",
          "conditions": [
            {
              "id": "a13a5e62-3a01-45f4-8ad2-fe80345e6cf4",
              "leftValue": "={{ $json.needs_human }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "ddb14c45-af94-4597-960e-801e9d46c4d6",
