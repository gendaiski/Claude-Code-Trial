      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"You are a sales qualifier. Given a new lead, decide if it fits the ICP (edit the ICP here). Return {\\\"good_fit\\\":\\\"yes|no\\\",\\\"reason\\\":\\\"...\\\",\\\"first_touch\\\":\\\"a personalised opening message\\\"}.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1024, messages: [ { role: \"user\", content } ] } } };"
      },
