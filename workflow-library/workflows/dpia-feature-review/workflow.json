    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Review this feature's personal-data handling: lawful basis, minimisation, retention, security, transfers, and subject rights. Flag gaps with a fix, and say whether a full DPIA is triggered (high-risk processing, profiling, large scale). Return {\\\"findings\\\":[{\\\"area\\\":\\\"...\\\",\\\"status\\\":\\\"OK|Gap\\\",\\\"risk\\\":\\\"...\\\",\\\"fix\\\":\\\"...\\\"}],\\\"dpia_required\\\":\\\"yes|no\\\"}. Drafting support, not legal advice \\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "44b9131e-2427-4f2d-b859-0763476d1a01",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
