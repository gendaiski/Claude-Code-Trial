    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Score this lead against our ICP (edit the ICP here). Return {\\\"fit\\\":\\\"A|B|C\\\",\\\"reasons\\\":[\\\"...\\\"],\\\"next_step\\\":\\\"...\\\",\\\"route\\\":\\\"sales|nurture|disqualify\\\"}. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "8d4bb5b1-ec19-45f6-b68f-3d4df5b00627",
