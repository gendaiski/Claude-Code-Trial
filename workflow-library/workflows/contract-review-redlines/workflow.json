{
  "name": "Contract Review & Redlines",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contract-review",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "63212f62-40e2-4e63-aa33-bf340cd0173a",
