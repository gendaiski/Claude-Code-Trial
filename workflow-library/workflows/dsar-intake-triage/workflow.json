    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Classify this data-subject request (access|erasure|rectification|portability|objection). Note whether identity verification is needed, the statutory response deadline, and the steps to fulfil it. Return {\\\"type\\\":\\\"...\\\",\\\"identity_check_needed\\\":\\\"yes|no\\\",\\\"deadline\\\":\\\"...\\\",\\\"steps\\\":[\\\"...\\\"]}. Drafting support, not legal advice \\\\u2014 a qualified lawyer reviews and signs; the workflow never sends, files, or executes anything; grounded steps use only provided sources; escalate contentious or high-value matters to counsel.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "395c69af-a48f-414f-b0b6-352a5135677b",
