      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "4d8730c1-b2d1-4e5c-98af-d00ee048864f",
              "leftValue": "={{ $json.recommendation }}",
              "rightValue": "block",
              "operator": {
                "type": "string",
