    {
      "parameters": {
        "jsCode": "const input=$input.item.json;\nconst instruction=\"Using ONLY the provided knowledge-base context, draft a support reply. If the answer isn't in context, say so and route to a human. Return {\\\"reply\\\":\\\"...\\\",\\\"grounded\\\":\\\"yes|no\\\",\\\"escalate\\\":\\\"yes|no\\\",\\\"sources_used\\\":[\\\"...\\\"]}. A human reviews and approves before anything is sent, posted, paid, published, or executed; grounded steps use only provided sources; the workflow drafts and routes, it does not act autonomously.\";\nconst content=instruction+\"\\n\\nINPUT DATA (JSON):\\n\"+JSON.stringify(input,null,2)+\"\\n\\nReturn ONLY valid JSON, no prose.\";\nreturn { json: { _input: input, claudeBody: { model: \"claude-sonnet-4-5\", max_tokens: 1200, messages: [ { role: \"user\", content } ] } } };"
      },
      "id": "07a6b525-c56e-4db3-a8aa-e352f8e60786",
      "name": "Assess: build prompt",
      "type": "n8n-nodes-base.code",
