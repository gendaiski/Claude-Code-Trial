{
  "name": "termly",
  "version": "0.1.0",
  "description": "A small terminal CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "termly": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
